# backend/.env.example
# ─────────────────────────────────────────────────────────────
# Kopieren als: cp .env.example .env
# NIEMALS die echte .env in Git committen!
# ─────────────────────────────────────────────────────────────

# ── Pflichtfelder ─────────────────────────────────────────────
# PostgreSQL Connection-String
DATABASE_URL=postgresql://postgres:deinPasswort@localhost:5432/studytracker

# JWT-Secret — mindestens 32 Zeichen
# Generieren: openssl rand -hex 64
JWT_SECRET=aendere-mich-mindestens-32-zeichen-lang-zufaellig

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_EXPIRES_IN=15m

# URL des Frontends (kein abschließendes /)
# Development: http://localhost:5173
# Production:  https://deine-app.up.railway.app
CORS_ORIGIN=http://localhost:5173

# Basis-URL der App — wird in E-Mail-Links verwendet
# Development: http://localhost:5173
# Production:  https://deine-app.up.railway.app
APP_URL=http://localhost:5173

# ── E-Mail / SMTP (optional) ──────────────────────────────────
# Ohne SMTP-Config: E-Mails werden in Development auf Ethereal geloggt
# Empfohlene Provider: Resend (resend.com), Postmark, SendGrid
#
# Resend SMTP Beispiel:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxx
#
# SendGrid SMTP Beispiel:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxxxxx

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StudyTracker <noreply@deine-domain.de>
