# .env.example — Vorlage für docker-compose
# ─────────────────────────────────────────────────────────────
# Kopieren als: cp .env.example .env
# NIEMALS die echte .env in Git committen!
#
# Beide Variablen sind Pflicht — ohne sie startet docker compose nicht.
# ─────────────────────────────────────────────────────────────

# Datenbankpasswort für PostgreSQL
# Mindestens 16 Zeichen empfohlen
DB_PASSWORD=aendere-mich-sicheres-passwort

# JWT-Signatur-Schlüssel für Access-Tokens
# Generieren: openssl rand -hex 64
JWT_SECRET=aendere-mich-mindestens-32-zeichen-lang-zufaellig
